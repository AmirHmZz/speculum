# No admin credentials are configured through environment variables.
# First startup logs a generated password for admin. Change it on first login.

# Optional: pin a release or digest instead of following the stable latest tag.
# SPECULUM_IMAGE=ghcr.io/amirhmzz/speculum:0.2.1
# SPECULUM_IMAGE=ghcr.io/amirhmzz/speculum@sha256:<published-digest>

# Upstream fetches are INFO; request and cache details are DEBUG.
# To include cache/request details, use speculum=debug,tower_http=info.
RUST_LOG=speculum=info,tower_http=info
